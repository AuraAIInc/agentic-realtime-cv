# Copy to .env and fill in. Each component calls load_dotenv(), which looks for .env next to
# the code and then in parent folders, so one .env at the repo root works for all of them.
# Components that run on different machines (the camera on the Pi, the image server on the
# SSD host) each need their own .env with just their section.
#
# <...> = fill in. Lines starting with "# KEY=" are optional and show the default.

# ── Agent: agent/ (tracking pipeline + supervisor_agent) ──────────────────────
# Meta Model API key (the agent runs on Muse Spark). Name set by api_key_env in models.json.
MODEL_API_KEY=<Meta Model API key>
# Only for the open_weight role in models.json (Muse Spark Open on Baseten).
# BASETEN_API_KEY=<Baseten API key>

# One shared credential for every MCP server: the agent sends it, each server checks it.
MCP_AUTH_TOKEN=<long random string, same on every machine>
CAMERA_MCP_URL=http://<pi host>:8765/mcp
IMAGE_MCP_URL=http://<image server host>:10001/mcp
TRACKING_MCP_URL=http://<ingest server host>:10002/mcp
# An empty URL (e.g. CAMERA_MCP_URL=) leaves that server out.

# LOCAL_FRAME_DIRS=<dir>[:<dir>]   # frames local__get_frame reads (default image_server/retrieved_images/*/images)
# MEMORY_STORE_DIR=agent/memory/data   # short-/long-term memory files (any MEMORY_* overrides memory_config.yaml)
# AGENT_ENV_FILE is read from the process environment (not from here): every entry point then
# loads that file instead of this .env. run_demo.py uses it for its isolated demo config.
# MODEL_CONFIG=agent/supervisor_agent/models.json      # provider, per-role models, pricing
# AGENT_DATA_DIR=agent_data                            # cat profiles, references, labels, logs
# NO_COLOR=1                                           # plain CLI output
# Dump every agent run + tool call to MySQL (agent_invoke / tool_invoke tables), from a
# background thread. Uses the MYSQL_* settings in the ingest server section below.
AGENT_INVOKE_DUMP=true

# ── Camera: camera_server (camera_v3, runs on the Pi) ────────────────────────
# MCP control server. Without a token the server is open to anyone on the network.
MCP_AUTH_TOKEN=<same shared value>
# MCP_ENABLED=1        # 0 turns the MCP server off
# MCP_HOST=0.0.0.0     # 127.0.0.1 = local only
# MCP_PORT=8765
# MODELS_CONFIG=camera_v3/models.json
# DEVICE_ID_OVERRIDE=<device id>   # default: the Pi's serial number

# S3, for uploading images and downloading model weights
S3_AWS_DEFAULT_REGION=<region, e.g. us-west-1>
S3_AWS_ACCESS_KEY=<access key id>
S3_AWS_SECRET_ACCESS_KEY=<secret access key>

# ── Image server: image_server (mcp_image_server, runs on the SSD host) ──────
# IMAGE_ROOT=/mnt/extreme/Cat_monitor_data   # folder the camera images are stored in
# IMAGE_MCP_HOST=0.0.0.0
# IMAGE_MCP_PORT=10001
# Images captured after IMAGE_S3_CUTOFF_DATE are read from S3
# (s3://<bucket>/<prefix>/YYYY-MM-DD/HH/MM/<name>.jpg); older ones from IMAGE_ROOT.
# Without the S3_AWS_* keys the server runs local-only.
# IMAGE_S3_BUCKET=<bucket>              # required for S3 (no default); or HISTORY_IMAGE_BUCKET_NAME
# IMAGE_S3_PREFIX=<user id>/<device id>   # the camera's upload prefix
# IMAGE_S3_CUTOFF_DATE=2026-10-20
# S3_AWS_DEFAULT_REGION=<region, e.g. us-west-1>
# S3_AWS_ACCESS_KEY=<access key id>
# S3_AWS_SECRET_ACCESS_KEY=<secret access key>

# ── Ingest server: existing_work_before_hackathon ────────────────────────────
# detection_ingest_server.py, the track / period correctors and run_tracking_viz.py
MYSQL_HOST=<host>
MYSQL_PORT=3306
MYSQL_DB=<database>
MYSQL_USER=<user>
MYSQL_PASSWORD=<password>
# LOG_LEVEL=INFO
# LOG_FORMAT=%(asctime)s - [%(filename)s:%(lineno)d] - %(levelname)s - %(message)s

# Tracking MCP server, started inside detection_ingest_server.py by default.
# Without a token it runs with no auth.
# TRACKING_MCP_ENABLED=true   # false = never start; auto = start only when a token is set
# TRACKING_MCP_HOST=0.0.0.0
# TRACKING_MCP_PORT=10002
# TRACKING_IMAGE_ROOT=/mnt/extreme/Cat_monitor_data   # only for include_images=true

# Escalation-point thresholds (model/escalation_config.py; strategy in model/README.md).
# Each point is one JSON line on stdout; unset = default.
# ESCALATION_DUPLICATE_TIE_MARGIN=0.15   # T3: duplicate kill below this conf margin
# ESCALATION_SYNTH_GAP_SECONDS=5.0       # T7: interpolated-only run longer than this
# ESCALATION_VOTE_MARGIN=2.0             # P1: top-two vote margin below this
# ESCALATION_WEAK_WINNER_SCORE=3.0       # P2: winner score below this ...
# ESCALATION_WEAK_WINNER_MIN_LENGTH=10   # P2: ... or fewer original frames than this
# ESCALATION_UNKNOWN_MIN_SECONDS=10.0    # P4: unassigned period longer than this (or ...)
# ESCALATION_UNKNOWN_MIN_FRAMES=30       # P4: ... with more rows than this
# ESCALATION_LOW_MEAN_CONF=0.55          # P5: winner mean conf below this ...
# ESCALATION_LOW_DETECT_RATE=0.3         # P5: ... or original-frame rate below this
# ESCALATION_MERGE_GAP_SECONDS=60.0      # P6: gap to previous period within this ...
# ESCALATION_MERGE_MAX_DISTANCE=300.0    # P6: ... and box centers within this many px
# ESCALATION_STATIC_WINDOW_SECONDS=5.0   # P7: stillness window at each end of the gap
# ESCALATION_STATIC_MAX_PX=15.0          # P7: max box-center movement inside that window
# ESCALATION_STATIC_OVERLAP_IOU=0.5      # P7: new-head vs previous-tail box overlap above this
# ESCALATION_STATIC_LINK_MAX_GAP=600.0   # P7: gap up to this many seconds (10 min)

