# Copy to .env and fill in. Each component calls load_dotenv(), which looks for .env next to
# the code and then in parent folders, so one .env at the repo root works for all of them.
# Components that run on different machines (the camera on the Pi, the image server on the
# SSD host) each need their own .env with just their section.
#
# <...> = fill in. Lines starting with "# KEY=" are optional and show the default.

# ── Agent: agentic_realtime_cv_agent ─────────────────────────────────────────
# Meta Model API key (the agent runs on Muse Spark). Name set by api_key_env in models.json.
MODEL_API_KEY=<Meta Model API key>
# Only for the open_weight role in models.json (Muse Spark Open on Baseten).
# BASETEN_API_KEY=<Baseten API key>

# MCP servers the agent calls. Each token must match the server's own *_AUTH_TOKEN below.
CAMERA_MCP_URL=http://<pi host>:8765/mcp
CAMERA_MCP_TOKEN=<same as MCP_AUTH_TOKEN>
IMAGE_MCP_URL=http://<image server host>:10001/mcp
IMAGE_MCP_TOKEN=<same as IMAGE_MCP_AUTH_TOKEN>
TRACKING_MCP_URL=http://<ingest server host>:10002/mcp
TRACKING_MCP_TOKEN=<same as TRACKING_MCP_AUTH_TOKEN>

# MODEL_CONFIG=agentic_realtime_cv_agent/models.json   # provider, per-role models, pricing
# AGENT_DATA_DIR=agent_data                            # cat profiles, references, labels, logs
# NO_COLOR=1                                           # plain CLI output

# ── Camera: camera_server (camera_v3, runs on the Pi) ────────────────────────
# MCP control server. Without a token the server is open to anyone on the network.
MCP_AUTH_TOKEN=<long random string>
# MCP_ENABLED=1        # 0 turns the MCP server off
# MCP_HOST=0.0.0.0     # 127.0.0.1 = local only
# MCP_PORT=8765
# MODELS_CONFIG=camera_v3/models.json
# DEVICE_ID_OVERRIDE=<device id>   # default: the Pi's serial number

# S3, for uploading images and downloading model weights
S3_AWS_DEFAULT_REGION=<region, e.g. us-west-1>
S3_AWS_ACCESS_KEY=<access key id>
S3_AWS_SECRET_ACCESS_KEY=<secret access key>

# ── Image server: image_server (mcp_image_server, runs on the SSD host) ──────
IMAGE_MCP_AUTH_TOKEN=<long random string>
# IMAGE_ROOT=/mnt/extreme/Cat_monitor_data   # folder the camera images are stored in
# IMAGE_MCP_HOST=0.0.0.0
# IMAGE_MCP_PORT=10001

# ── Ingest server: existing_work_before_hackathon ────────────────────────────
# detection_ingest_server.py, the track / period correctors and run_tracking_viz.py
MYSQL_HOST=<host>
MYSQL_PORT=3306
MYSQL_DB=<database>
MYSQL_USER=<user>
MYSQL_PASSWORD=<password>
# LOG_LEVEL=INFO
# LOG_FORMAT=%(asctime)s - [%(filename)s:%(lineno)d] - %(levelname)s - %(message)s

# Tracking MCP server, started inside detection_ingest_server.py when a token is set
TRACKING_MCP_AUTH_TOKEN=<long random string>
# TRACKING_MCP_ENABLED=auto   # auto = only with a token; true = even without one; false = never
# TRACKING_MCP_HOST=0.0.0.0
# TRACKING_MCP_PORT=10002
# TRACKING_IMAGE_ROOT=/mnt/extreme/Cat_monitor_data   # only for include_images=true

# Only for the older pre-hackathon helpers in model/ (not used by the ingest server)
# FLASK_DEBUG=false                                        # model/config.py
# SERVER_ENDPOINT=https://localhost:5173                   # model/config.py
# USER_DATA_BUCKET_NAME=aura-user-data                     # model/config.py
# HISTORY_IMAGE_BUCKET_NAME=aura-history-image             # model/config.py
# SES_AWS_DEFAULT_REGION=<region>                          # model/ses_tool.py (email)
# SES_AWS_ACCESS_KEY=<access key id>
# SES_AWS_SECRET_ACCESS_KEY=<secret access key>
# SES_FROM_EMAIL=<verified sender address>
# The S3_AWS_* keys above are also used by model/ec2_training_pipeline.py.
