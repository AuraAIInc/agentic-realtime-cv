{
  "provider": "Meta Model API",
  "base_url": "https://api.meta.ai/v1",
  "api_key_env": "MODEL_API_KEY",
  "reasoning_effort": null,
  "roles": {
    "agent": {
      "model": "muse-spark-1.3",
      "use": "Agent reasoning, vision, tool calls; escalation teacher",
      "api": "responses"
    },
    "segmentation": {
      "model": "sam-3.1",
      "use": "Masks/boxes for training data (open-vocabulary finding is out of scope, §2)",
      "api": "responses"
    },
    "voice": {
      "model": "muse-voice-transcribe-1.0",
      "use": "Voice questions (if we build voice)",
      "api": "POST /v1/asr/transcribe, wss://api.meta.ai/v1/asr/realtime"
    },
    "creative": {
      "model": "muse-image-1.0",
      "writer_model": "muse-wonder-1.0",
      "use": "Creative output, e.g. a daily \"cat diary\" comic (Best Creative Build): Muse Wonder writes it, Muse Image draws it",
      "api": "POST /v1/images/generations, /v1/images/edits"
    },
    "open_weight": {
      "model": "meta-models/muse-spark-open-1026",
      "use": "Local or partner-hosted model (Best Open Weight; privacy). Muse Glimmer is the self-hosted alternative",
      "base_url": "https://inference.baseten.co/v1",
      "api_key_env": "BASETEN_API_KEY",
      "api": "chat_completions"
    },
    "coding": {
      "model": null,
      "product": "Muse Code",
      "use": "Coding (a coding-agent product, not an API model)"
    }
  },
  "pricing_source": "https://dev.meta.ai/docs/pricing-rate-limits (Standard mode)",
  "pricing_retrieved": "2026-10-26",
  "pricing_usd_per_1m_tokens": {
    "muse-spark-1.3": {
      "input": 1.25,
      "cached_input": 0.15,
      "output": 4.25
    },
    "muse-spark-1.3-contributor": {
      "input": 0.1,
      "cached_input": 0.002,
      "output": 0.2
    },
    "muse-spark-1.1": {
      "input": 1.25,
      "cached_input": 0.15,
      "output": 4.25
    }
  },
  "pricing_other_usd": {
    "muse-image-1.0": "0.01 per image",
    "sam-3.1": "2.50 per 1,000 images, 0.20 per 1,000 video frames",
    "muse-voice-transcribe-1.0": "0.18 per hour of audio"
  }
}
