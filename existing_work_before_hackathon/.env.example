# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_DEBUG=false
# URL of the frontend (used for CORS origin allowlist)
SERVER_ENDPOINT=https://localhost:5173

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=<generate a long random string>

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_HOST=<host>
MYSQL_PORT=3306
MYSQL_DB=aura_cat
MYSQL_USER=<user>
MYSQL_PASSWORD=<password>

# ── AWS S3 (app bucket access) ────────────────────────────────────────────────
S3_AWS_DEFAULT_REGION=us-west-1
S3_AWS_ACCESS_KEY=<access key id>
S3_AWS_SECRET_ACCESS_KEY=<secret access key>

# S3 bucket names (override if your buckets are named differently)
USER_DATA_BUCKET_NAME=aura-user-data
HISTORY_IMAGE_BUCKET_NAME=aura-history-image

# ── AWS SES (email notifications) ─────────────────────────────────────────────
SES_AWS_DEFAULT_REGION=us-west-1
SES_AWS_ACCESS_KEY=<access key id>
SES_AWS_SECRET_ACCESS_KEY=<secret access key>
# A verified SES sender address
SES_FROM_EMAIL=<your-verified-sender@example.com>
# Where login / registration notifications are delivered
ADMIN_NOTIFICATION_EMAIL=<your-admin@example.com>

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<google oauth client id>
GOOGLE_CLIENT_SECRET=<google oauth client secret>

# ── Auto-train (EC2 training pipeline) ───────────────────────────────────────
# Namespace prefix used for S3 keys in the training pipeline
S3_USER_NAMESPACE=<your-name-or-org>
# Bucket that stores training datasets and model artifacts
MODEL_TRAINING_BUCKET_NAME=aura-model-training
TRAINING_DATASET_BUCKET_NAME=aura-training-datasets
ZIP_PASSWORD=<password used to encrypt dataset zips>

# ── Raspberry Pi file transfer (optional) ────────────────────────────────────
PI_SSH_USER=<pi username>
PI_SSH_HOST=<pi ip or hostname>
PI_SSH_KEY_NAME=<key filename in ~/.ssh/>
# PI_SSH_DIR=~/.ssh   # override if your SSH keys live elsewhere

# ── Tracking MCP server (runs inside detection_ingest_server.py) ─────────────────────
# Starts when a token is set; TRACKING_MCP_ENABLED=false disables it.
TRACKING_MCP_AUTH_TOKEN=<random string>
# TRACKING_MCP_PORT=10002
# TRACKING_IMAGE_ROOT=/mnt/extreme/Cat_monitor_data   # only for include_images=true

# ── MCP agent (../agentic_realtime_cv_agent) ────────────────────────────────
# MODEL_API_KEY=<Meta Model API key>
# TRACKING_MCP_URL=http://<websocket server host>:10002/mcp
# TRACKING_MCP_TOKEN=<same as TRACKING_MCP_AUTH_TOKEN>
